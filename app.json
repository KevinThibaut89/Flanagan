{
  "expo": {
    "name": "Flanagan",
    "slug": "flanagan",
    "scheme": "flanagan",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kevinthibaut.flanagan"
    },
    "android": {
      "package": "com.kevinthibaut.flanagan",
      "adaptiveIcon": {
        "backgroundColor": "#1A1210",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Flanagan uses the camera to scan bottle barcodes so it can add them to your bar."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ca54032-dc92-48b7-bc3c-81c2fc009e2f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ca54032-dc92-48b7-bc3c-81c2fc009e2f"
    }
  }
}
