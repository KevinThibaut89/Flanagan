# Copy to .env and fill in from your Supabase project settings.
# Both values are safe to ship in the app bundle: the anon/publishable key only
# grants what row-level security allows.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# RevenueCat public SDK key. The Test Store key (test_…) works in Expo Go and dev
# builds with RevenueCat's simulated store; the App Store / Play keys (appl_… /
# goog_…) replace it in the build profiles that ship. Not a secret either way.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_your-revenuecat-test-store-key
